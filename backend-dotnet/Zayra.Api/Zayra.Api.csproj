<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Zayra.Api.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Noto Sans Arabic (SIL OFL 1.1, Assets/Fonts/OFL.txt) is embedded rather than copied to
       the output directory: the production container must not depend on a file landing next to
       the DLL, and DocumentFonts turns QuestPDF's host-font fallback OFF so this is the ONLY
       source of Arabic glyphs. A missing resource fails at startup, not at issuance. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\NotoSansArabic-Regular.ttf" LogicalName="Zayra.Api.Assets.Fonts.NotoSansArabic-Regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\NotoSansArabic-Bold.ttf" LogicalName="Zayra.Api.Assets.Fonts.NotoSansArabic-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.400.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.0.11" />
    <!-- DataProtection 8.0.11 resolves Cryptography.Xml 8.0.2 transitively. Pin the July 2026
         patched servicing release so XML-signature CVEs cannot pass the fail-closed NuGet gate. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <!-- Security: pin the patched System.IO.Packaging (8.0.1) to override the vulnerable 8.0.0 that
         DocumentFormat.OpenXml.Framework pulls in transitively — GHSA-f32c-w444-8ppv / GHSA-qj66-m88j-hmgj. -->
    <PackageReference Include="System.IO.Packaging" Version="8.0.1" />
    <PackageReference Include="QuestPDF" Version="2025.1.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.11" />
    <!-- W2-D (S3): profile-photo re-encode (decode JPEG/PNG, orient, downscale to 512px, re-encode
         JPEG with NO metadata). MIT-licensed. The NoDependencies Linux asset bundles libSkiaSharp for
         the Debian aspnet:8.0 runtime image without needing fontconfig/libfreetype apt packages. -->
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
  </ItemGroup>
</Project>
