# Local development can use http://localhost:5117/api in the iOS simulator.
EXPO_PUBLIC_API_BASE_URL=https://zayra-ai-workforce.onrender.com/api
EXPO_PUBLIC_APP_ENV=staging

# Optional override; the linked EAS project ID is stored in app.json.
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Crash reporting is OFF unless a DSN is set (docs/CRASH_REPORTING.md). Never commit a real DSN
# to a shared file; set it as an EAS environment variable for the build profile.
# EXPO_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
