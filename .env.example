# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DATABASE=zayra
POSTGRES_USER=zayra
POSTGRES_PASSWORD=zayra_password
POSTGRES_PORT=5432

# Backend DB connection string. The docker-compose stack builds this automatically from the
# POSTGRES_* values above. For a NON-docker / dedicated client-hosted deployment set it directly
# (Production throws if unset):
# ConnectionStrings__Default=Host=<host>;Port=5432;Database=zayra;Username=<user>;Password=<pass>;SSL Mode=Require;Trust Server Certificate=true

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=5117
FRONTEND_PORT=3000

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Only this variable is needed in Vercel for the frontend deployment.
# Set to your Railway (or other) backend URL in production.
# Vercel: NEXT_PUBLIC_API_BASE_URL=https://zayra-ai-workforce-production-2b92.up.railway.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:5117

# ── JWT ───────────────────────────────────────────────────────────────────────
# Backend-only — never set these in Vercel frontend environment.
JWT_ISSUER=Zayra.Api
JWT_AUDIENCE=Zayra.Client
# Each deployment MUST use its OWN unique key (>=64 chars). Generate: openssl rand -base64 64
# In any non-Development environment the app refuses to boot on this placeholder value.
JWT_SIGNING_KEY=CHANGE_ME_TO_A_64_CHARACTER_PRODUCTION_SECRET_KEY_1234567890

# ── Platform Admin (backend-only) ─────────────────────────────────────────────
PLATFORM_ADMIN_EMAIL=platform@yourdomain.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PLATFORM_ADMIN_PASSWORD

# ── Seeding (backend-only) ────────────────────────────────────────────────────
SEED_TENANT_NAME=Zayra HQ
SEED_TENANT_SLUG=zayra
SEED_ADMIN_EMAIL=admin@zayra.local
SEED_ADMIN_NAME=Zayra Admin
# First-boot bootstrap admin password. MUST be unique & strong per deployment.
# In Production (or when DEDICATED_DEPLOYMENT/CLIENT_DEPLOYMENT=true) the app REFUSES to boot when
# this is unset, a CHANGE_ME* placeholder, or the weak 'ChangeMe123!' default. NOTE: the app reads
# the config key SeedAdmin:Password (env SeedAdmin__Password); on docker-compose this SEED_ADMIN_PASSWORD
# is interpolated into SeedAdmin__Password — on Render / raw containers set SeedAdmin__Password directly.
SEED_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_UNIQUE_ADMIN_PASSWORD

# Demo seeders (demo tenants + demo users). OFF by default. NEVER set "true" on a
# deployment that holds real data.
SEED_DEMO_DATA=false

# Client-hosted / dedicated-deployment hard lock. When "true" (Production is ALWAYS treated as
# dedicated), demo seeders are refused even if SEED_DEMO_DATA=true, AND the bootstrap-admin password
# fail-fast is enforced regardless of ASPNETCORE_ENVIRONMENT — one mis-set flag can never pollute a
# client DB with demo data or boot a weak admin. Give every client deployment its own unique
# JWT_SIGNING_KEY and SEED_ADMIN_PASSWORD.
DEDICATED_DEPLOYMENT=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
