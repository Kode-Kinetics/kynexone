# Keep the Docker build context small: the root Dockerfile only needs backend-dotnet/Zayra.Api.
# The EF model snapshot is a design-time file (dotnet ef); the runtime model comes from OnModelCreating.
.git
**/node_modules
frontend
kynexbridge
.next
**/.next
.vercel
**/.vercel
**/bin
**/obj
database/*.sql
docs
*.md
.claude
e2e
**/*.test.*
backend-dotnet/Zayra.Api/Migrations/*ModelSnapshot.cs
backend-dotnet/Zayra.Api.Tests
tools
deploy
