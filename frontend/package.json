{
  "name": "kynexone-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/lint-ratchet.mjs && node scripts/design-token-ratchet.mjs",
    "lint:tokens": "node scripts/design-token-ratchet.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "test:unit:tz": "TZ=Asia/Karachi playwright test -c playwright.unit.config.ts",
    "i18n:repin": "I18N_REPIN=1 playwright test -c e2e/playwright.browserless.config.ts e2e/i18n-coverage.spec.ts",
    "seed:demo-masar": "playwright test -c e2e/release-a/playwright.demo-seed.config.ts",
    "lint:raw": "eslint app src middleware.ts instrumentation.ts",
    "lint:repin": "node scripts/lint-ratchet.mjs --repin"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@sentry/nextjs": "10.77.1",
    "@vercel/otel": "2.1.3",
    "axios": "1.20.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.16.0",
    "next": "^15.5.25",
    "qrcode": "1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "3.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.60.0",
    "@types/leaflet": "1.9.20",
    "@types/node": "25.9.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "6.0.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "$postcss",
    "sharp": "0.35.5"
  }
}
