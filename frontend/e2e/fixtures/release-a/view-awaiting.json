  "reasons": {
    "ENTITLEMENT_NOT_IN_GRADE": {
      "code": "ENTITLEMENT_NOT_IN_GRADE",
      "titleEn": "Not included for this grade",
      "titleAr": "\u063A\u064A\u0631 \u0645\u0634\u0645\u0648\u0644\u0629 \u0641\u064A \u0647\u0630\u0647 \u0627\u0644\u062F\u0631\u062C\u0629",
      "whyEn": "The grade table says employees in this grade do not get this benefit.",
      "whyAr": "\u064A\u062D\u062F\u062F \u062C\u062F\u0648\u0644 \u0627\u0644\u062F\u0631\u062C\u0627\u062A \u0623\u0646 \u0645\u0648\u0638\u0641\u064A \u0647\u0630\u0647 \u0627\u0644\u062F\u0631\u062C\u0629 \u0644\u0627 \u064A\u062D\u0635\u0644\u0648\u0646 \u0639\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0645\u064A\u0632\u0629.",
      "fixEn": "If the grade should include it, change it in Benefits by grade.",
      "fixAr": "\u0625\u0630\u0627 \u0643\u0627\u0646 \u064A\u062C\u0628 \u0623\u0646 \u062A\u0634\u0645\u0644\u0647\u0627 \u0627\u0644\u062F\u0631\u062C\u0629\u060C \u0639\u062F\u0651\u0644\u0647\u0627 \u0641\u064A \u0627\u0644\u0645\u0632\u0627\u064A\u0627 \u062D\u0633\u0628 \u0627\u0644\u062F\u0631\u062C\u0629.",
      "ownerRole": "HR Director"
    },
    "ENTITLEMENT_TERM_RUNNING_NEEDS_PROPOSAL": {
      "code": "ENTITLEMENT_TERM_RUNNING_NEEDS_PROPOSAL",
      "titleEn": "Needs a second person\u0027s check",
      "titleAr": "\u064A\u062D\u062A\u0627\u062C \u0625\u0644\u0649 \u062A\u062D\u0642\u0642 \u0634\u062E\u0635 \u0622\u062E\u0631",
      "whyEn": "This contract term has already started, so its benefits are taken from the grade table only as a proposal that another HR user checks against the signed contract.",
      "whyAr": "\u0628\u062F\u0623 \u0647\u0630\u0627 \u0627\u0644\u0639\u0642\u062F \u0628\u0627\u0644\u0641\u0639\u0644\u060C \u0644\u0630\u0644\u0643 \u062A\u0624\u062E\u0630 \u0645\u0632\u0627\u064A\u0627\u0647 \u0645\u0646 \u062C\u062F\u0648\u0644 \u0627\u0644\u062F\u0631\u062C\u0627\u062A \u0643\u0645\u0642\u062A\u0631\u062D \u0641\u0642\u0637 \u064A\u0631\u0627\u062C\u0639\u0647 \u0645\u0633\u062A\u062E\u062F\u0645 \u0622\u062E\u0631 \u0641\u064A \u0627\u0644\u0645\u0648\u0627\u0631\u062F \u0627\u0644\u0628\u0634\u0631\u064A\u0629 \u0645\u0642\u0627\u0628\u0644 \u0627\u0644\u0639\u0642\u062F \u0627\u0644\u0645\u0648\u0642\u0651\u0639.",
      "fixEn": "Propose the package, then ask another HR user to confirm it.",
      "fixAr": "\u0627\u0642\u062A\u0631\u062D \u0627\u0644\u0628\u0627\u0642\u0629 \u062B\u0645 \u0627\u0637\u0644\u0628 \u0645\u0646 \u0645\u0633\u062A\u062E\u062F\u0645 \u0622\u062E\u0631 \u0641\u064A \u0627\u0644\u0645\u0648\u0627\u0631\u062F \u0627\u0644\u0628\u0634\u0631\u064A\u0629 \u062A\u0623\u0643\u064A\u062F\u0647\u0627.",
      "ownerRole": "HR Manager"
    }
  },
